    <import addon="xbmc.python" version="3.0.0" />
    <import addon="repository.foundry" version="1.2.0" />
    <import addon="skin.foundry" version="1.1.1" />
    <import addon="script.module.cocoscrapers" version="1.0.45" />
    <import addon="slyguy.trailers" version="0.2.2" />
    <import addon="plugin.video.themoviedb.helper" version="5.4.16" />
    <import addon="metadata.themoviedb.org.python" version="3.2.2" />
    <import addon="metadata.tvshows.themoviedb.org.python" version="1.7.13" />
