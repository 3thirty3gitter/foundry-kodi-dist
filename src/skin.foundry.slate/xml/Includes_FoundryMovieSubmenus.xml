  <!-- Fallback only: existing selected-title fanart still renders above this image. -->
  <variable name="FoundryMovieSubmenuBase">
    <value condition="$EXP[FoundryMovieSubmenuAvailable] + !String.IsEmpty(Skin.String(HomeFanart.path))">$INFO[Skin.String(HomeFanart.path)]movies$INFO[Skin.String(HomeFanart.ext)]</value>
    <value condition="$EXP[FoundryMovieSubmenuAvailable] + !String.IsEmpty(Skin.String(NimbusCustomBackground))">$INFO[Skin.String(NimbusCustomBackground)]</value>
    <value condition="$EXP[FoundryMovieSubmenuAvailable]">$VAR[FoundryMovieSubmenuWallpaper]</value>
    <value>streampilot/catalog-base.png</value>
  </variable>
  <variable name="FoundryNativeLoadingBackdrop">
    <value condition="$EXP[FoundryMovieSubmenuAvailable]">$VAR[FoundryMovieSubmenuBase]</value>
    <value condition="String.IsEqual(Window(Home).Property(foundry.slate.navigation.category),movies) + !String.IsEmpty(Skin.String(HomeFanart.path))">$INFO[Skin.String(HomeFanart.path)]movies$INFO[Skin.String(HomeFanart.ext)]</value>
    <value condition="!String.IsEmpty(Skin.String(NimbusCustomBackground))">$INFO[Skin.String(NimbusCustomBackground)]</value>
    <value condition="String.IsEqual(Window(Home).Property(foundry.slate.navigation.category),movies)">resource://resource.images.foundry.wallpapers/movies.png</value>
    <value>streampilot/catalog-base.png</value>
  </variable>
  <variable name="FoundryCatalogFirstPaintBackdrop">
    <value condition="String.IsEmpty(Window.Property(catalog.section))">$VAR[FoundryNativeLoadingBackdrop]</value>
    <value>$VAR[FoundryMovieSubmenuBase]</value>
  </variable>
  <include name="FoundryMovieSubmenuBackdrop">
    <control type="image">
      <description>Approved Movies submenu wallpaper</description>
      <left>0</left><top>0</top><width>100%</width><height>100%</height>
      <aspectratio>keep</aspectratio>
      <fadetime>450</fadetime>
      <texture background="true">$VAR[FoundryMovieSubmenuWallpaper]</texture>
      <visible>$EXP[FoundryMovieSubmenuBackdropVisible]</visible>
    </control>
  </include>
