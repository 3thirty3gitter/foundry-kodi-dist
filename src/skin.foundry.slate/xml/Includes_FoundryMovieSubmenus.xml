<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <expression name="FoundryMovieSubmenuBackdropVisible">$EXP[FoundryMovieSubmenuNativeContext] + $EXP[FoundryMovieSubmenuAvailable] + !Control.IsVisible(57) + !Player.HasVideo + !Player.HasAudio + String.IsEmpty(Skin.String(HomeFanart.path)) + String.IsEmpty(Skin.String(NimbusCustomBackground)) + [ListItem.IsFolder | [String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(Window(Home).Property(foundry.slate.metadata.fanart))]]</expression>
  <!-- Exact labels and explicit Movies context; provider IDs/URLs are never matched. -->
  <expression name="FoundryMovieSubmenuNativeContext">Window.IsActive(videos) + !String.IsEqual(Container.FolderName,TV Shows) + !String.IsEqual(Container.FolderName,TV) + !String.IsEqual(Container.FolderName,Television) + !String.IsEqual(Container.PluginCategory,TV Shows) + !String.IsEqual(Container.PluginCategory,TV) + !String.IsEqual(Container.PluginCategory,Television) + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(episodes) + !Container.Content(addons) + [Container.Content(movies) | [String.IsEqual(Window(Home).Property(foundry.slate.navigation.category),movies) + [Container.Content(videos) | Container.Content(files) | String.IsEmpty(Container.Content)]]]</expression>
  <expression name="FoundryMovieSubmenuFocused">$EXP[FoundryMovieSubmenuNativeContext] + ListItem.IsFolder + !ListItem.IsParentFolder + [String.IsEqual(ListItem.Label,Trending) | String.IsEqual(ListItem.Label,Trending Recent) | String.IsEqual(ListItem.Label,Popular) | String.IsEqual(ListItem.Label,Popular Today) | String.IsEqual(ListItem.Label,Premieres) | String.IsEqual(ListItem.Label,Latest Releases) | String.IsEqual(ListItem.Label,Most Watched) | String.IsEqual(ListItem.Label,Most Favorited) | String.IsEqual(ListItem.Label,Top 10 Box Office) | String.IsEqual(ListItem.Label,Blockbusters) | String.IsEqual(ListItem.Label,In Theaters) | String.IsEqual(ListItem.Label,Up Coming) | String.IsEqual(ListItem.Label,Oscar Winners) | String.IsEqual(ListItem.Label,Genres) | String.IsEqual(ListItem.Label,Providers) | String.IsEqual(ListItem.Label,Languages) | String.IsEqual(ListItem.Label,Years) | String.IsEqual(ListItem.Label,Decades) | String.IsEqual(ListItem.Label,Certifications) | String.IsEqual(ListItem.Label,Because You Watched...) | String.IsEqual(ListItem.Label,Watched) | String.IsEqual(ListItem.Label,Recently Watched) | String.IsEqual(ListItem.Label,In Progress)]</expression>
  <expression name="FoundryMovieSubmenuDirectory">$EXP[FoundryMovieSubmenuNativeContext] + [String.IsEqual(Container.FolderName,Trending) | String.IsEqual(Container.FolderName,Trending Recent) | String.IsEqual(Container.FolderName,Popular) | String.IsEqual(Container.FolderName,Popular Today) | String.IsEqual(Container.FolderName,Premieres) | String.IsEqual(Container.FolderName,Latest Releases) | String.IsEqual(Container.FolderName,Most Watched) | String.IsEqual(Container.FolderName,Most Favorited) | String.IsEqual(Container.FolderName,Top 10 Box Office) | String.IsEqual(Container.FolderName,Blockbusters) | String.IsEqual(Container.FolderName,In Theaters) | String.IsEqual(Container.FolderName,Up Coming) | String.IsEqual(Container.FolderName,Oscar Winners) | String.IsEqual(Container.FolderName,Genres) | String.IsEqual(Container.FolderName,Providers) | String.IsEqual(Container.FolderName,Languages) | String.IsEqual(Container.FolderName,Years) | String.IsEqual(Container.FolderName,Decades) | String.IsEqual(Container.FolderName,Certifications) | String.IsEqual(Container.FolderName,Because You Watched...) | String.IsEqual(Container.FolderName,Watched) | String.IsEqual(Container.FolderName,Recently Watched) | String.IsEqual(Container.FolderName,In Progress)]</expression>
  <expression name="FoundryMovieSubmenuCatalog">String.IsEqual(Window.Property(catalog.section),Movies) + [String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Trending) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Trending Recent) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Popular) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Popular Today) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Premieres) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Latest Releases) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Most Watched) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Most Favorited) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Top 10 Box Office) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Blockbusters) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),In Theaters) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Up Coming) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Oscar Winners) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Genres) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Providers) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Languages) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Years) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Decades) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Certifications) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Because You Watched...) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Watched) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),Recently Watched) | String.IsEqual(Window.Property(foundry.slate.movie_submenu_label),In Progress)]</expression>
  <!-- Parent entry on the Movies category page uses its own matching Back plate.
       Inside a known submenu, retain that directory's existing category plate. -->
  <expression name="FoundryMovieSubmenuBack">$EXP[FoundryMovieSubmenuNativeContext] + ListItem.IsParentFolder + String.IsEqual(Container.FolderName,Movies)</expression>
  <expression name="FoundryMovieSubmenuAvailable">$EXP[FoundryMovieSubmenuCatalog] | $EXP[FoundryMovieSubmenuFocused] | $EXP[FoundryMovieSubmenuDirectory] | $EXP[FoundryMovieSubmenuBack]</expression>
  <variable name="FoundryMovieSubmenuLabel">
    <!-- Helper supplies verified canonical Movies context and restores it on Back. -->
    <value condition="$EXP[FoundryMovieSubmenuCatalog]">$INFO[Window.Property(foundry.slate.movie_submenu_label)]</value>
    <value condition="$EXP[FoundryMovieSubmenuFocused]">$INFO[ListItem.Label]</value>
    <value condition="$EXP[FoundryMovieSubmenuDirectory]">$INFO[Container.FolderName]</value>
    <value />
  </variable>
