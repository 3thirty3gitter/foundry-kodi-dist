    <value condition="!String.IsEmpty(ListItem.MPAA) + !String.IsEqual(ListItem.MPAA,N/A) + !String.IsEqual(ListItem.MPAA,0) + !String.IsEqual(ListItem.MPAA,0.0)">$INFO[ListItem.MPAA]</value>
    <value condition="$EXP[FoundryOmdbCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.omdb.certification)) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.certification),N/A) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.certification),0) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.certification),0.0)">$INFO[Window(Home).Property(foundry.slate.omdb.certification)]</value>
    <value />
