    <value condition="!String.IsEmpty(ListItem.Art(studio.logo))">$INFO[ListItem.Art(studio.logo)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.studiologo))">$INFO[ListItem.Art(tvshow.studiologo)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.studio.logo))">$INFO[ListItem.Art(tvshow.studio.logo)]</value>
    <value />
  </variable>
  <variable name="FoundryVODPage">
    <value condition="Integer.IsGreater(Container(57).NumPages,0)">Page $INFO[Container(57).CurrentPage]</value>
    <value>Page 1</value>
  </variable>
