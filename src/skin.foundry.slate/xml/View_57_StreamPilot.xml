    <value>FF48A8F0</value>
  </variable>
  <variable name="FoundryVODPlot">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.plot))">$INFO[Window(Home).Property(foundry.slate.metadata.plot)]</value>
