  <variable name="FoundryVODTMDb">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.tmdb))">$INFO[Window(Home).Property(foundry.slate.metadata.tmdb)]</value>
    <value condition="!String.IsEmpty(ListItem.Rating(themoviedb)) + !String.IsEqual(ListItem.Rating(themoviedb),N/A) + !String.IsEqual(ListItem.Rating(themoviedb),0) + !String.IsEqual(ListItem.Rating(themoviedb),0.0)">$INFO[ListItem.Rating(themoviedb)]</value>
    <value condition="!String.IsEmpty(ListItem.Rating(tmdb)) + !String.IsEqual(ListItem.Rating(tmdb),N/A) + !String.IsEqual(ListItem.Rating(tmdb),0) + !String.IsEqual(ListItem.Rating(tmdb),0.0)">$INFO[ListItem.Rating(tmdb)]</value>
    <value />
  </variable>
  <variable name="FoundryVODTitle">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.title))">$INFO[Window(Home).Property(foundry.slate.metadata.title)]</value>
    <value>$INFO[ListItem.Title]</value>
    <value>$INFO[ListItem.Label]</value>
  </variable>
  <variable name="FoundryVODSection">
    <value condition="Window.IsActive(favouritesbrowser)">Favorites</value>
    <value condition="Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)">TV Series</value>
    <value>Movies</value>
  </variable>
  <variable name="FoundryVODType">
    <value condition="String.IsEqual(ListItem.DBTYPE,episode) | Container.Content(episodes)">TV Episode</value>
    <value condition="String.IsEqual(ListItem.DBTYPE,season) | Container.Content(seasons)">TV Season</value>
    <value condition="String.IsEqual(ListItem.DBTYPE,tvshow) | Container.Content(tvshows)">TV Series</value>
    <value>Movie</value>
  </variable>
  <variable name="FoundryVODDetails">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.details))">$INFO[Window(Home).Property(foundry.slate.metadata.details)]</value>
    <value condition="$EXP[FoundryVODCurrentItem]">$INFO[Window(Home).Property(foundry.slate.vod.details)]</value>
    <value>$VAR[FoundryVODType]$INFO[ListItem.Genre,  •  ,]$INFO[ListItem.Studio,  •  ,]$INFO[ListItem.AudioLanguage,  •  ,]</value>
  </variable>
  <variable name="FoundryVODStudioLogo">
    <value condition="$EXP[FoundryVODCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.vod.studio_logo))">$INFO[Window(Home).Property(foundry.slate.vod.studio_logo)]</value>
