    <value condition="$EXP[FoundryOmdbCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.omdb.plot)) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.plot),N/A) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.plot),0) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.plot),0.0)">$INFO[Window(Home).Property(foundry.slate.omdb.plot)]</value>
