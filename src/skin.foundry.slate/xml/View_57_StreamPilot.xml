    <value condition="!String.IsEmpty(ListItem.Premiered) + !String.IsEqual(ListItem.Premiered,N/A) + !String.IsEqual(ListItem.Premiered,0) + !String.IsEqual(ListItem.Premiered,0.0)">$INFO[ListItem.Premiered]</value>
