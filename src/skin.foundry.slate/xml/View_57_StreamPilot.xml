    <value condition="!String.IsEmpty(ListItem.Studio) + !String.IsEqual(ListItem.Studio,N/A) + !String.IsEqual(ListItem.Studio,0) + !String.IsEqual(ListItem.Studio,0.0)">$INFO[ListItem.Studio]</value>
    <value condition="$EXP[FoundryOmdbCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.omdb.studio)) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.studio),N/A) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.studio),0) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.studio),0.0)">$INFO[Window(Home).Property(foundry.slate.omdb.studio)]</value>
    <value />
  </variable>
  <variable name="FoundryVODIMDb">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.imdb))">$INFO[Window(Home).Property(foundry.slate.metadata.imdb)]</value>
    <value condition="$EXP[FoundryOmdbCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.omdb.imdb_rating)) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.imdb_rating),N/A) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.imdb_rating),0) + !String.IsEqual(Window(Home).Property(foundry.slate.omdb.imdb_rating),0.0)">$INFO[Window(Home).Property(foundry.slate.omdb.imdb_rating)]</value>
    <value condition="!String.IsEmpty(ListItem.Rating(imdb)) + !String.IsEqual(ListItem.Rating(imdb),N/A) + !String.IsEqual(ListItem.Rating(imdb),0) + !String.IsEqual(ListItem.Rating(imdb),0.0)">$INFO[ListItem.Rating(imdb)]/10</value>
    <value />
