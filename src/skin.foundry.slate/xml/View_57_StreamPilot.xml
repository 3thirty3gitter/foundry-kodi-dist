<?xml version='1.0' encoding='UTF-8'?>
<includes>
  <!-- Glow belongs to the selected native row item, not a repeated texture context. -->
  <expression name="FoundryVODGlowCurrentItem">!String.IsEmpty(Window(Home).Property(foundry.slate.vod.owner_label)) + String.IsEqual(Window(Home).Property(foundry.slate.vod.owner_label),Container(57).ListItem.Label) + String.IsEqual(Window(Home).Property(foundry.slate.vod.owner_year),Container(57).ListItem.Year) + String.IsEqual(Window(Home).Property(foundry.slate.vod.owner_type),Container(57).ListItem.DBTYPE) + [String.IsEqual(Window(Home).Property(foundry.slate.vod.owner_path),Container(57).ListItem.FileNameAndPath) | String.IsEqual(Window(Home).Property(foundry.slate.vod.owner_path),Container(57).ListItem.Path)]</expression>
  <variable name="FoundryVODGlow">
    <value condition="$EXP[FoundryVODGlowCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.vod.glow))">$INFO[Window(Home).Property(foundry.slate.vod.glow)]</value>
    <value>streampilot/glow-pending.svg</value>
  </variable>
  <variable name="FoundryVODPosterImage">
    <value condition="$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.poster))">$INFO[Window(Home).Property(foundry.slate.metadata.poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
    <value>$INFO[ListItem.Icon]</value>
  </variable>
  <variable name="FoundryVODAccent">
