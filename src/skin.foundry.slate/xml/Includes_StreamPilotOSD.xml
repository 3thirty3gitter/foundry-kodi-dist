<?xml version='1.0' encoding='UTF-8'?>
<includes>
  <variable name="StreamPilotOSDAccent">
    <value condition="!String.IsEmpty(Window(home).Property(foundry.slate.osd.accent))">$INFO[Window(home).Property(foundry.slate.osd.accent)]</value>
    <value>FF182A3B</value>
  </variable>
  <variable name="StreamPilotOSDShade">
    <value condition="!String.IsEmpty(Window(home).Property(foundry.slate.osd.shade))">$INFO[Window(home).Property(foundry.slate.osd.shade)]</value>
    <value>FF070D12</value>
  </variable>
  <variable name="StreamPilotOSDPoster">
    <value condition="$EXP[FoundryPlayerCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.player.poster))">$INFO[Window(Home).Property(foundry.slate.player.poster)]</value>
    <value condition="!String.IsEmpty(Player.Art(poster))">$INFO[Player.Art(poster)]</value>
    <value condition="!String.IsEmpty(Player.Art(tvshow.poster))">$INFO[Player.Art(tvshow.poster)]</value>
    <value>$INFO[Player.Icon]</value>
  </variable>
  <variable name="StreamPilotOSDLogo">
    <value condition="$EXP[FoundryPlayerCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.player.clearlogo))">$INFO[Window(Home).Property(foundry.slate.player.clearlogo)]</value>
    <value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[Player.Art(clearlogo)]</value>
    <value>$INFO[Player.Art(tvshow.clearlogo)]</value>
  </variable>
  <variable name="StreamPilotOSDTitle">
    <value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
    <value>$INFO[Player.Title]</value>
  </variable>
  <variable name="StreamPilotOSDPauseIcon">
    <value condition="Player.Paused | Player.Forwarding | Player.Rewinding">streampilot/play_arrow.png</value>
    <value>streampilot/pause.png</value>
  </variable>
  <variable name="StreamPilotOSDResolution">
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,4K)">resource://resource.images.foundry.osd/resolution_4k_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,2160)">resource://resource.images.foundry.osd/resolution_4k_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,1080)">resource://resource.images.foundry.osd/resolution_fhd_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,720)">resource://resource.images.foundry.osd/resolution_hd_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,576)">resource://resource.images.foundry.osd/resolution_sd_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,540)">resource://resource.images.foundry.osd/resolution_sd_supplied.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.VideoResolution,480)">resource://resource.images.foundry.osd/resolution_sd_supplied.jpg</value>
    <value />
  </variable>
  <variable name="StreamPilotOSDChannels">
    <value condition="String.IsEqual(VideoPlayer.AudioChannels,2)">resource://resource.images.foundry.osd/audio_2_0.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioChannels,6)">resource://resource.images.foundry.osd/audio_5_1.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioChannels,8)">resource://resource.images.foundry.osd/audio_7_1.jpg</value>
    <value />
  </variable>
  <variable name="StreamPilotOSDAudio">
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,eac3-joc)">resource://resource.images.foundry.osd/audio_dolby_atmos.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,truehd)">resource://resource.images.foundry.osd/audio_dolby_truehd.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,eac3)">resource://resource.images.foundry.osd/audio_dolby_digital_plus.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,ac3)">resource://resource.images.foundry.osd/audio_dolby_digital.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma)">resource://resource.images.foundry.osd/audio_dts_hd.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra)">resource://resource.images.foundry.osd/audio_dts_hd.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,dca_ma)">resource://resource.images.foundry.osd/audio_dts_hd.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,dca_hra)">resource://resource.images.foundry.osd/audio_dts_hd.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,flac)">resource://resource.images.foundry.osd/audio_flac.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,aac)">resource://resource.images.foundry.osd/audio_aac.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,aac_latm)">resource://resource.images.foundry.osd/audio_aac.jpg</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,pcm)">resource://resource.images.foundry.osd/audio_pcm.jpg</value>
    <value condition="String.StartsWith(VideoPlayer.AudioCodec,pcm_)">resource://resource.images.foundry.osd/audio_pcm.jpg</value>
    <value />
  </variable>
  <variable name="StreamPilotOSDAudioLabel">
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,dts) | String.IsEqual(VideoPlayer.AudioCodec,dca)">DTS</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,ac4)">AC-4</value>
    <value condition="String.IsEqual(VideoPlayer.AudioCodec,mp3) | String.IsEqual(VideoPlayer.AudioCodec,mp2)">MPEG</value>
    <value>Audio</value>
  </variable>
  <variable name="StreamPilotOSDLiveStart">
    <value condition="VideoPlayer.HasEPG">$INFO[PVR.EpgEventStartTime]</value>
    <value>LIVE</value>
  </variable>
  <variable name="StreamPilotOSDLiveEnd">
    <value condition="VideoPlayer.HasEPG">$INFO[PVR.EpgEventFinishTime]</value>
    <value />
  </variable>
  <variable name="FoundryPlaybackStudioLogo">
    <value condition="$EXP[FoundryPlayerCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.player.studiologo))">$INFO[Window(Home).Property(foundry.slate.player.studiologo)]</value>
    <value condition="!String.IsEmpty(Player.Art(studiologo))">$INFO[Player.Art(studiologo)]</value>
    <value condition="!String.IsEmpty(Player.Art(studio.logo))">$INFO[Player.Art(studio.logo)]</value>
    <value condition="!String.IsEmpty(Player.Art(tvshow.studiologo))">$INFO[Player.Art(tvshow.studiologo)]</value>
    <value />
  </variable>
  <include name="FoundryPlaybackStudioLogo">
    <control type="image">
      <description>Current playback studio logo at the top right</description>
      <right>60</right>
      <top>40</top>
      <width>320</width>
      <height>110</height>
      <aspectratio align="right" aligny="center">keep</aspectratio>
      <visible>Player.HasVideo + !VideoPlayer.Content(livetv) + [[$EXP[FoundryPlayerCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.player.studiologo))] | !String.IsEmpty(Player.Art(studiologo)) | !String.IsEmpty(Player.Art(studio.logo)) | !String.IsEmpty(Player.Art(tvshow.studiologo))]</visible>
      <texture background="true">$VAR[FoundryPlaybackStudioLogo]</texture>
    </control>
  </include>
  <variable name="FoundryOSDPlaybackTime">
    <value condition="Player.Seeking">$INFO[Player.SeekTime(h:mm:ss)]  /  $INFO[Player.Duration(h:mm:ss)]</value>
    <value>$INFO[Player.Time(h:mm:ss)]  /  $INFO[Player.Duration(h:mm:ss)]</value>
  </variable>
  <variable name="FoundryOSDLiveSeekTime">
    <value condition="Player.Seeking + VideoPlayer.HasEPG">$INFO[PVR.EpgEventSeekTime]$INFO[PVR.EpgEventDuration, / ]</value>
    <value condition="VideoPlayer.HasEPG">$INFO[PVR.EpgEventElapsedTime]$INFO[PVR.EpgEventDuration, / ]</value>
    <value>$VAR[FoundryOSDPlaybackTime]</value>
  </variable>
  <include name="StreamPilotFormatBadges">
    <control type="grouplist">
      <height>54</height>
      <orientation>horizontal</orientation>
      <itemgap>10</itemgap>
      <aligny>center</aligny>
      <control type="image">
        <width>76</width>
        <height>54</height>
        <aspectratio>keep</aspectratio>
        <visible>!String.IsEmpty(VideoPlayer.VideoResolution)</visible>
        <texture>$VAR[StreamPilotOSDResolution]</texture>
      </control>
      <control type="image">
        <width>76</width>
        <height>54</height>
        <aspectratio>keep</aspectratio>
        <visible>String.IsEqual(VideoPlayer.AudioChannels,2) | String.IsEqual(VideoPlayer.AudioChannels,6) | String.IsEqual(VideoPlayer.AudioChannels,8)</visible>
        <texture>$VAR[StreamPilotOSDChannels]</texture>
      </control>
      <control type="image">
        <width>76</width>
        <height>54</height>
        <aspectratio>keep</aspectratio>
        <visible>!String.IsEmpty(VideoPlayer.AudioCodec) + [String.IsEqual(VideoPlayer.AudioCodec,eac3-joc) | String.IsEqual(VideoPlayer.AudioCodec,truehd) | String.IsEqual(VideoPlayer.AudioCodec,eac3) | String.IsEqual(VideoPlayer.AudioCodec,ac3) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra) | String.IsEqual(VideoPlayer.AudioCodec,dca_ma) | String.IsEqual(VideoPlayer.AudioCodec,dca_hra) | String.IsEqual(VideoPlayer.AudioCodec,flac) | String.IsEqual(VideoPlayer.AudioCodec,aac) | String.IsEqual(VideoPlayer.AudioCodec,aac_latm) | String.IsEqual(VideoPlayer.AudioCodec,pcm) | String.StartsWith(VideoPlayer.AudioCodec,pcm_)]</visible>
        <texture>$VAR[StreamPilotOSDAudio]</texture>
      </control>
      <control type="label">
        <font>SPTime</font>
        <textcolor>FFB9CBD7</textcolor>
        <height>54</height>
        <aligny>center</aligny>
        <width>76</width>
        <visible>!String.IsEmpty(VideoPlayer.AudioCodec) + ![String.IsEqual(VideoPlayer.AudioCodec,eac3-joc) | String.IsEqual(VideoPlayer.AudioCodec,truehd) | String.IsEqual(VideoPlayer.AudioCodec,eac3) | String.IsEqual(VideoPlayer.AudioCodec,ac3) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra) | String.IsEqual(VideoPlayer.AudioCodec,dca_ma) | String.IsEqual(VideoPlayer.AudioCodec,dca_hra) | String.IsEqual(VideoPlayer.AudioCodec,flac) | String.IsEqual(VideoPlayer.AudioCodec,aac) | String.IsEqual(VideoPlayer.AudioCodec,aac_latm) | String.IsEqual(VideoPlayer.AudioCodec,pcm) | String.StartsWith(VideoPlayer.AudioCodec,pcm_)]</visible>
        <label>$VAR[StreamPilotOSDAudioLabel]</label>
      </control>
    </control>
  </include>
