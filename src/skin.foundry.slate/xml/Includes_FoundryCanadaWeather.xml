<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundry Canada provider card; other selected weather providers retain the existing Home widgets. -->
<includes>
  <variable name="FoundryCanadaHomeWeatherVar">
    <!-- Native manager polling is demand-driven; custom Window properties do not poll it. -->
    <value condition="String.IsEqual(Weather.Plugin,weather.foundry.canada) + !Weather.IsFetched"></value>
    <value condition="String.IsEqual(Weather.Plugin,weather.foundry.canada) + String.IsEqual(Window(weather).Property(Foundry.Weather.HasCurrent),true)">$INFO[Window(weather).Property(Foundry.Weather.Temperature)] $INFO[Window(weather).Property(Foundry.Weather.Condition)]</value>
    <value condition="String.IsEqual(Weather.Plugin,weather.foundry.canada)"></value>
    <value>$VAR[HomeMenuWeatherVar]</value>
  </variable>
