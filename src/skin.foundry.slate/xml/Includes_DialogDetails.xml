  <include name="FoundryDialogArtPreview">
    <control type="group">
      <visible>String.IsEqual(Container(20000).ListItem.Property(id),art)</visible>
      <left>620</left>
      <width>1160</width>
      <control type="image">
        <top>160</top>
        <right>-20</right>
        <width>520</width>
        <height>780</height>
        <aspectratio>keep</aspectratio>
        <texture>$INFO[Container(5051).ListItem.Icon]</texture>
        <visible>!String.IsEqual(Container(5051).ListItem.Property(id),edit)</visible>
      </control>
      <control type="list" id="5051">
        <top>67</top>
        <height>940</height>
        <width>540</width>
        <onleft>20000</onleft>
        <onback>SetFocus(20000)</onback>
        <include content="CenterList104">
          <param name="id" value="5051" />
        </include>
        <include content="CastItem">
          <param name="id" value="5051" />
          <param name="MainLabel" value="$INFO[ListItem.Label]" />
          <param name="SubLabel" value="$INFO[ListItem.Label2]" />
        </include>
        <content>
          <item>
            <label>Poster</label>
            <label2>Artwork for this title</label2>
            <icon>$VAR[FoundryMetadataPoster]</icon>
            <visible>!String.IsEmpty(ListItem.Art(poster)) | [$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.poster))]</visible>
          </item>
          <item>
            <label>Background</label>
            <label2>Artwork for this title</label2>
            <icon>$VAR[FoundryMetadataFanart]</icon>
            <visible>!String.IsEmpty(ListItem.Art(fanart)) | [$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.fanart))]</visible>
          </item>
          <item>
            <label>Title artwork</label>
            <label2>Artwork for this title</label2>
            <icon>$VAR[FoundryMetadataClearlogo]</icon>
            <visible>!String.IsEmpty(ListItem.Art(clearlogo)) | [$EXP[FoundryMetadataCurrentItem] + !String.IsEmpty(Window(Home).Property(foundry.slate.metadata.clearlogo))]</visible>
          </item>
          <item>
            <label>Change artwork</label>
            <label2>Open Kodi artwork editor</label2>
            <property name="id">edit</property>
            <onclick>SendClick(10)</onclick>
            <visible>Control.IsEnabled(10) + Integer.IsGreater(ListItem.DBID,0)</visible>
          </item>
        </content>
      </control>
      <control type="textbox">
        <left>0</left>
        <top>160</top>
        <width>540</width>
        <height>240</height>
        <font>font32</font>
        <textcolor>unfocused_text</textcolor>
        <label>Loading artwork...</label>
        <visible>!Integer.IsGreater(Container(5051).NumItems,0) + [$EXP[FoundryMetadataCurrentItem] + String.IsEqual(Window(Home).Property(foundry.slate.metadata.loading),true)]</visible>
      </control>
      <control type="textbox">
        <left>0</left>
        <top>160</top>
        <width>540</width>
        <height>240</height>
        <font>font32</font>
        <textcolor>unfocused_text</textcolor>
        <label>No artwork is available for this title.</label>
        <visible>!Integer.IsGreater(Container(5051).NumItems,0) + [![$EXP[FoundryMetadataCurrentItem] + String.IsEqual(Window(Home).Property(foundry.slate.metadata.loading),true)]]</visible>
