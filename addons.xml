<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="repository.foundry" version="1.2.0" name="Foundry Repository" provider-name="3Thirty3">
    <extension point="xbmc.addon.repository" name="Foundry Repository">
      <dir minversion="21.0.0">
        <info compressed="false">https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/</datadir>
        <hashes>sha256</hashes>
      </dir>
      <dir minversion="21.0.0">
        <info compressed="false">https://slyguy.uk/.repo/repository.slyguy/addons.xml</info>
        <checksum>https://slyguy.uk/.repo/repository.slyguy/addons.xml.md5</checksum>
        <datadir zip="true">https://slyguy.uk/.repo/repository.slyguy/</datadir>
      </dir>
      <dir minversion="21.0.0">
        <info compressed="false">https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Foundry Kodi skin and installer</summary>
      <description lang="en_GB">Install Foundry Build from Program add-ons, or Foundry from Look and feel &gt; Skin.</description>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="resource.images.foundry.wallpapers" name="Foundry Wallpapers" version="1.0.0" provider-name="3Thirty3">
    <requires>
      <import addon="kodi.resource" version="1.0.0" />
    </requires>
    <extension point="kodi.resource.images" compile="false" type="backgrounds" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Original Foundry category wallpapers</summary>
      <description lang="en_GB">The original fourteen Foundry wallpapers, preserved unchanged and installed with the Foundry skin.</description>
      <platform>all</platform>
      <license>CC BY-SA 4.0</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/home.png</fanart>
      </assets>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="resource.images.foundry.osd" name="Foundry StreamPilot OSD Artwork" version="1.0.0" provider-name="3Thirty3">
    <requires>
      <import addon="kodi.resource" version="1.0.0" />
    </requires>
    <extension point="kodi.resource.images" compile="false" type="mediaflags" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Original StreamPilot playback format badges</summary>
      <description lang="en_GB">Resolution and audio format artwork used by the Foundry StreamPilot playback OSD.</description>
      <platform>all</platform>
      <license>Proprietary artwork; respective trademarks belong to their owners</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
      </assets>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="skin.foundry" version="1.1.3" name="Foundry" provider-name="3Thirty3 / Ivar Brandt">
    <requires>
      <import addon="xbmc.gui" version="5.17.0" />
      <import addon="script.foundry.helper" version="1.1.1" />
      <import addon="resource.images.foundry.wallpapers" version="1.0.0" />
      <import addon="resource.images.foundry.osd" version="1.0.0" />
    </requires>
    <extension point="xbmc.gui.skin" debugging="false">
      <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
      <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
      <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
      <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
      <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
      <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
      <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
      <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/foundry-fanart.png</fanart>
      </assets>
      <summary lang="en_GB">Foundry skin by 3Thirty3 (based on Nimbus by Ivar Brandt)</summary>
      <summary lang="en_NZ">Foundry skin by 3Thirty3 (based on Nimbus by Ivar Brandt)</summary>
      <summary lang="en_US">Foundry skin by 3Thirty3 (based on Nimbus by Ivar Brandt)</summary>
      <description lang="en_GB">Foundry - a 3Thirty3 Kodi skin built on Nimbus by Ivar Brandt. GPLv2 code / CC BY-SA 4.0 artwork; upstream attribution retained.</description>
      <description lang="en_NZ">Foundry - a 3Thirty3 Kodi skin built on Nimbus by Ivar Brandt. GPLv2 code / CC BY-SA 4.0 artwork; upstream attribution retained.</description>
      <description lang="en_US">Foundry - a 3Thirty3 Kodi skin built on Nimbus by Ivar Brandt. GPLv2 code / CC BY-SA 4.0 artwork; upstream attribution retained.</description>
    </extension>
  </addon>
  <addon id="script.foundry.helper" name="Foundry Helper" version="1.1.1" provider-name="3Thirty3 / Ivar Brandt">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.requests" version="2.19.1" />
      <import addon="script.module.pil" version="1.1.7" />
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py" />
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
      <news />
      <platform>all</platform>
      <license>GPL-2.0-only, CC BY-SA 4.0 (artwork)</license>
      <forum />
      <source>https://github.com/3thirty3gitter/script.foundry.helper</source>
      <assets>
        <icon>resources/media/icon.png</icon>
        <fanart>resources/media/fanart.png</fanart>
      </assets>
      <description lang="en_GB">Foundry Helper for the Foundry Skin. Forked from Nimbus Helper by Ivar Brandt.</description>
      <description lang="en_NZ">Foundry Helper for the Foundry Skin. Forked from Nimbus Helper by Ivar Brandt.</description>
      <description lang="en_US">Foundry Helper for the Foundry Skin. Forked from Nimbus Helper by Ivar Brandt.</description>
    </extension>
  </addon>
  <addon id="script.program.foundry-build" version="1.2.3" name="Foundry Build" provider-name="3Thirty3">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="repository.foundry" version="1.2.0" />
      <import addon="skin.foundry" version="1.1.3" />
      <import addon="script.module.cocoscrapers" version="1.0.45" />
      <import addon="slyguy.trailers" version="0.2.2" />
      <import addon="plugin.video.themoviedb.helper" version="5.4.16" />
      <import addon="metadata.themoviedb.org.python" version="3.2.2" />
      <import addon="metadata.tvshows.themoviedb.org.python" version="1.7.13" />
      <import addon="resource.uisounds.androidtv" version="1.0.0" />
      <import addon="inputstream.adaptive" version="21.0.0" />
      <import addon="script.module.inputstreamhelper" version="0.8.6" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Install and activate the Foundry skin</summary>
      <description lang="en_GB">Installs Foundry, CocoScrapers, SlyGuy Trailers, TMDb Helper, movie and TV metadata scrapers, Android TV UI sounds, and adaptive playback support. Kodi manages their dependencies. Run Foundry Build to activate the skin.</description>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="script.program.foundry-bootstrap" version="1.2.3" name="Foundry Bootstrap Installer" provider-name="3Thirty3">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.program.foundry-build" version="1.2.3" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Foundry installer shortcut</summary>
      <description lang="en_GB">Open the Foundry Build installer. Kodi manages all required dependencies.</description>
    </extension>
  </addon>
</addons>
