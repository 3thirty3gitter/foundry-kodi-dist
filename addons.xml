<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="repository.foundry" version="1.2.0" name="Foundry Repository" provider-name="3Thirty3">
    <extension point="xbmc.addon.repository" name="Foundry Repository">
      <dir minversion="21.0.0">
        <info compressed="false">https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/3thirty3gitter/foundry-kodi-dist/main/</datadir>
        <hashes>sha256</hashes>
      </dir>
      <dir minversion="21.0.0">
        <info compressed="false">https://slyguy.uk/.repo/repository.slyguy/addons.xml</info>
        <checksum>https://slyguy.uk/.repo/repository.slyguy/addons.xml.md5</checksum>
        <datadir zip="true">https://slyguy.uk/.repo/repository.slyguy/</datadir>
      </dir>
      <dir minversion="21.0.0">
        <info compressed="false">https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/not-coco-joe/repository.cocoscrapers/master/zips/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Foundry Kodi skin and installer</summary>
      <description lang="en_GB">Install Foundry Build from Program add-ons, or Foundry from Look and feel &gt; Skin.</description>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="resource.images.foundry.wallpapers" name="Foundry Wallpapers" version="1.1.1" provider-name="3Thirty3">
    <requires>
      <import addon="kodi.resource" version="1.0.0" />
    </requires>
    <extension point="kodi.resource.images" compile="false" type="backgrounds" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Approved fixed-background Foundry wallpapers</summary>
      <description lang="en_GB">Fourteen owner-approved Foundry wallpapers using the fixed, subdued Trending background. Matching smaller widget variants are bundled in the skin. Historical releases remain unchanged.</description>
      <platform>all</platform>
      <license>CC BY-SA 4.0</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/home.png</fanart>
      </assets>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="resource.images.foundry.osd" name="Foundry StreamPilot OSD Artwork" version="1.0.0" provider-name="3Thirty3">
    <requires>
      <import addon="kodi.resource" version="1.0.0" />
    </requires>
    <extension point="kodi.resource.images" compile="false" type="mediaflags" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Original StreamPilot playback format badges</summary>
      <description lang="en_GB">Resolution and audio format artwork used by the Foundry StreamPilot playback OSD.</description>
      <platform>all</platform>
      <license>Proprietary artwork; respective trademarks belong to their owners</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
      </assets>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="resource.uisounds.foundry.pulse" version="1.1.0" name="Foundry Quick Relay UI Sounds" provider-name="3Thirty3">
    <requires>
      <import addon="kodi.resource" version="1.0.0" />
    </requires>
    <extension point="kodi.resource.uisounds" />
    <extension point="kodi.addon.metadata">
      <summary lang="en">The selected Quick Relay UI sound for Foundry</summary>
      <description lang="en">One quiet Quick Relay cue for navigation, selection and back. The existing error cue is preserved. Kodi controls mute, GUI volume and playback sound behavior.</description>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="weather.foundry.canada" name="Foundry Canada Weather" version="0.1.0" provider-name="Foundry">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.weather" library="default.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Canadian weather for Foundry</summary>
      <summary lang="fr_FR">Météo canadienne pour Foundry</summary>
      <description lang="en_GB">Private development prototype for Kodi 21. Manual Canadian city selection, current conditions, hourly and seven-day forecasts, and advisory headlines. No account, API key, GPS or IP geolocation. Not an emergency-warning system.</description>
      <description lang="fr_FR">Prototype privé pour Kodi 21. Choix manuel d’une ville canadienne, conditions actuelles, prévisions horaires et sur sept jours et titres d’avis. Sans compte, clé API ni géolocalisation. Ne remplace pas les alertes d’urgence.</description>
      <platform>all</platform>
      <license>Proprietary development prototype; data subject to its upstream licence</license>
    </extension>
  </addon>
  <addon id="plugin.games.foundry" version="0.1.0" name="Foundry Games" provider-name="3Thirty3">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>game</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Your game library, played with Kodi RetroPlayer</summary>
      <description lang="en_GB">Browse user-supplied games by console, search, favorites and recent launches. Native Kodi manages emulators, controllers and saves. No ROMs, BIOS, emulator binaries or remote metadata are bundled.</description>
    </extension>
  </addon>
  <addon id="skin.foundry" version="1.5.4" name="Foundry" provider-name="3Thirty3 / Ivar Brandt">
    <requires>
      <import addon="xbmc.gui" version="5.17.0" />
