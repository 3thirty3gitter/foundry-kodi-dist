  <addon id="script.program.foundry-build" version="1.5.4" name="Foundry Build" provider-name="3Thirty3">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="repository.foundry" version="1.2.0" />
      <import addon="skin.foundry" version="1.5.4" />
      <import addon="weather.foundry.canada" version="0.1.0" />
      <import addon="plugin.games.foundry" version="0.1.0" />
      <import addon="script.module.cocoscrapers" version="1.0.45" />
      <import addon="plugin.video.themoviedb.helper" version="5.4.16" />
      <import addon="metadata.themoviedb.org.python" version="3.2.2" />
      <import addon="metadata.tvshows.themoviedb.org.python" version="1.7.13" />
      <import addon="resource.uisounds.foundry.pulse" version="1.0.0" />
      <import addon="inputstream.adaptive" version="21.0.0" />
      <import addon="script.module.inputstreamhelper" version="0.8.6" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <summary lang="en_GB">Install and activate the Foundry skin</summary>
      <description lang="en_GB">Installs Foundry, CocoScrapers, SlyGuy Trailers, TMDb Helper, movie and TV metadata scrapers, Foundry Pulse UI sounds, Foundry Games, Canadian Weather, and adaptive playback support. Weather remains inactive until selected and configured. Kodi manages their dependencies. Run Foundry Build to activate the skin.</description>
      <source>https://github.com/3thirty3gitter/foundry-kodi-dist</source>
    </extension>
  </addon>
  <addon id="script.program.foundry-bootstrap" version="1.5.4" name="Foundry Bootstrap Installer" provider-name="3Thirty3">
